# Host port the agent's HTTP API is published on.
AGENT_PORT=8080

# Host port Ollama is published on (handy for `ollama` CLI against the container).
OLLAMA_PORT=11434

# Model the agent talks to. It must support tool calling.
# llama3.2 is a reasonable default; llama3.2:1b is faster but calls tools worse.
OLLAMA_MODEL=llama3.2

# How many model turns one request may take before giving up.
AGENT_MAX_STEPS=5

# info | debug
LOG_LEVEL=info
